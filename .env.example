# Copy to .env and fill in. Existing environment variables win over this file.

# --- image model -------------------------------------------------------------
# gpu_instances | genai_instance | modal_comfy | diffusers | mock
SOUVENIR_BACKEND=gpu_instances
# occo gpu-instances project. pod = one pod from scripts\start.bat (URL/key read from .state.json),
# gateway = production job API (PROD_URL / PROD_API_KEY read from gpu-instances\.env)
GPU_INSTANCES_MODE=pod
GPU_INSTANCES_DIR=C:/dev/occo/gpu-instances
# Optional overrides for pod mode
GPU_POD_URL=
GPU_POD_KEY=
# Older C:\dev\genai_instance worker (only if SOUVENIR_BACKEND=genai_instance)
GENAI_QWEN_URL=
GENAI_DEPLOYMENTS=C:/dev/genai_instance/.genai/deployments.json
# Modal ComfyUI endpoint + an S3 bucket for temporary input images
MODAL_QWEN_URL=
SOUVENIR_TMP_BUCKET=

# --- VLM (analyzer / planner / verifier) -------------------------------------
# Any OpenAI-compatible server. Self-hosted vLLM keeps guest photos in your infrastructure:
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --max-model-len 16384
VLM_BASE_URL=http://localhost:8000/v1
VLM_API_KEY=EMPTY
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# --- detection / identity -----------------------------------------------------
# insightface | rekognition | mock
SOUVENIR_DETECTOR=insightface
# vlm_judge | insightface | rekognition | mock
SOUVENIR_IDENTITY=vlm_judge
# AWS credentials come from your normal AWS profile / env (AWS_PROFILE, AWS_REGION)

# --- baseline (evaluation only) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
